DATABASE_URL="file:./dev.db"
# Required. The server refuses to start without one, because a session cookie
# signed with a guessable key can be forged for any account. At least 32
# characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it later signs everybody out and re-pairs the Plex connection, since
# the Plex client identifier is derived from it.
AUTH_SECRET=""

# Get a free key at https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 read access token works.
TMDB_API_KEY=""

# Optional. Free key at https://www.omdbapi.com/apikey.aspx
# Enables Rotten Tomatoes, Metacritic and IMDb scores on title pages.
OMDB_API_KEY=""

# Which country's streaming availability to show under "Where to watch".
# ISO 3166-1 country code. Defaults to US. This is the instance-wide default;
# any account can pick its own country under Settings -> Your region.
WATCH_REGION="US"

# Optional. Identifies this install to plex.tv for "Continue with Plex".
# Derived from AUTH_SECRET when unset, which is fine for a single deployment.
PLEX_CLIENT_ID=""

# Optional fallback only. Trakt is configured per user under Settings -> Trakt;
# set this and users need to enter just their username instead of also bringing
# their own client id. Create an app at https://trakt.tv/oauth/applications.
TRAKT_CLIENT_ID=""

# Optional. Enables "what is on tonight" push notifications.
# Generate a pair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact URL for the push services, e.g. mailto:you@example.com
VAPID_SUBJECT=""

# Required to call the daily jobs: /api/notifications/run (reminders) and
# /api/lists/refresh (rebuilding smart lists). Both are optional — smart lists
# also rebuild themselves when a stale one is looked at.
CRON_SECRET=""

# Optional. Enables the Plex webhook (Plex Pass only), which logs a play the
# moment Plex scrobbles it instead of waiting for the next sync.
# Point Plex at: https://your-trekker/api/plex/webhook?key=<this value>
# Use URL-safe characters only (A-Z a-z 0-9 - _). The value rides in the query
# string, so an & silently truncates it and a # is dropped before Plex sends it,
# both of which look like a plain 401. `openssl rand -base64 32 | tr '+/' '-_'`
# or node's crypto.randomBytes(32).toString("base64url") both work.
PLEX_WEBHOOK_SECRET=""
