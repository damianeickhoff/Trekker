# The database file. Point this at a *copy* of the current Trekker database,
# migrated to this schema (`npx prisma migrate deploy`). The current app cannot
# share a migrated file: ratings there are now 1 to 5, not percentages.
DATABASE_URL="file:./data/trekker-migrated.db"

# The same value the current instance uses, so its session cookies stay valid,
# and so the Plex and Overseerr credentials it sealed can be opened.
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# TMDB v3 API key or v4 read access token. Without it nothing is fetched: Home
# still shows where you are from your own history, but no next episode.
TMDB_API_KEY=""

# Streaming availability region for anyone who has not chosen one (ISO 3166-1).
WATCH_REGION="GB"

# Guards /api/cron, for running the refresh jobs from an external scheduler,
# and /api/notifications/run, the morning push, which nothing inside the app
# schedules (the refresh job's 04:00 is no hour to buzz a phone).
CRON_SECRET=""

# Web push. Generate a pair once with `npx web-push generate-vapid-keys`.
# Without both keys push stays off and Settings says so.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for the push services: a mailto: or https: address.
VAPID_SUBJECT="mailto:you@example.com"

# Plex. Neither is needed: the server, Overseerr and the webhook secrets are
# set up in Settings and kept (sealed) in the database.
# PLEX_CLIENT_ID identifies this install to plex.tv; unset, it is derived from
# AUTH_SECRET, as the current app does, so both apps are the same client.
# PLEX_CLIENT_ID=""
# The current app's webhook secret. Set it to the same value and a Plex server
# already pointed at /api/plex/webhook?key=... keeps logging after the switch;
# the address and secret in the Plex sheet work either way.
# PLEX_WEBHOOK_SECRET=""

# Trakt API client id for the whole instance, so people can import with only a
# username. Anyone can still use their own. Trakt import needs a public profile.
# TRAKT_CLIENT_ID=""

# Where profile pictures are kept. Defaults to 'avatars' beside the database
# file, which in the container is /data/avatars.
# AVATAR_DIR="/data/avatars"

# Where the screensaver's weather is for: the household's town, as a latitude,
# a longitude and the name to print. Open-Meteo is asked at most once an hour
# and needs no key. Unset, the admin account's place from the current app is
# used if it had one, and otherwise there is no weather line.
# WEATHER_LATITUDE="52.09"
# WEATHER_LONGITUDE="5.12"
# WEATHER_PLACE="Utrecht"

# Popular news on the News page: entertainment sites' RSS or Atom feeds, read
# once a night, headlines and links only. Unset, a built-in list is used
# (Variety, Deadline, The Hollywood Reporter, Screen Rant, Collider, IndieWire,
# TVLine). Comma-separated addresses replace it; set and empty turns it off.
# NEWS_FEEDS="https://variety.com/v/tv/feed/,https://deadline.com/feed/"
