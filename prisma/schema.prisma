generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  /// Null for accounts created by signing in with Plex — they have no password
  /// of their own and authenticate through plex.tv every time.
  passwordHash     String?
  /// plex.tv account id, set when the account is linked to Plex.
  plexAccountId    String?   @unique
  /// plex.tv auth token for *this* user, from the sign-in flow. Used to read
  /// their personal watchlist, which lives on plex.tv rather than the server.
  plexAuthToken    String?
  /// Which Plex account is playing, for the "now watching" card. Filled in from
  /// the sign-in flow; settable by hand for accounts that use a password.
  plexUsername     String?
  /// A managed profile in somebody's Plex Home — a partner, a brother, a child.
  /// They have no plex.tv login and no email address of their own, so `email`
  /// on this row is a placeholder that exists only to satisfy the unique index.
  /// Nothing should show it, and nothing should let them sign in with it.
  plexManaged      Boolean   @default(false)
  /// When this profile was introduced to the rest of its Plex Home — i.e. when
  /// friendships were created with the housemates it shares a Plex login with.
  /// Stamped so it happens exactly once: unfriending someone deletes the row, so
  /// an introduction that ran on every sign-in would quietly undo it.
  plexHomeLinkedAt DateTime?

  /// Streaming services the user pays for, as TMDB provider ids, comma
  /// separated. Used to warn before requesting something they can already watch.
  providers String?

  /// Which country's streaming availability this person sees, as an ISO 3166-1
  /// code. Null means the instance's WATCH_REGION — the right answer for a
  /// household in one country, which is most of them. Set per account for the
  /// housemate living abroad, whose catalogue is genuinely different.
  region String?

  /// Backdrop shown behind the profile header, chosen from a title page.
  coverBackdrop String?
  coverTitle    String?
  accent        String    @default("violet")
  /// What the user picked: "dark" | "light" | "system".
  theme         String    @default("system")
  /// What that currently resolves to: "dark" | "light". Stored separately
  /// because only the browser knows what "system" means, and the server has to
  /// put a concrete value on <html> in the very first byte it sends.
  themeResolved String    @default("dark")
  /// Avatar is kept in the database and served by /api/avatar/[id], so it does
  /// not depend on writing into the statically-served public folder.
  avatarData    Bytes?
  avatarType    String?
  avatarSetAt   DateTime?
  createdAt     DateTime  @default(now())

  /// Optional Plex Media Server link, e.g. http://192.168.1.10:32400
  plexUrl       String?
  /// X-Plex-Token for that server. Stored as given — keep the database private.
  plexToken     String?
  /// Server machine identifier, used to build app.plex.tv deep links.
  plexMachineId String?

  /// Overseerr / Jellyseerr instance, e.g. http://192.168.1.10:5055
  seerrUrl    String?
  /// API key for that instance.
  seerrApiKey String?

  /// Trakt is per user: everyone imports their own history, so everyone brings
  /// their own API client id and profile name. TRAKT_CLIENT_ID in the
  /// environment is used as a fallback when a user has not set one.
  traktClientId String?
  traktUsername String?

  /// The two webhooks' secrets, instance-wide and so on the admin's row beside
  /// the connections they belong to. Sealed like the tokens (`token-vault.ts`),
  /// shown in the Manage sheets, and made on first sight there. Plex cannot
  /// send a header, so its secret rides in the address; Overseerr sends it as
  /// the Authorization header it lets you set.
  plexWebhookSecret  String?
  seerrWebhookSecret String?

  /// When this person's Plex history was last read into their plays, by the
  /// half-hourly job or Sync now. Null means never, which the job reads as due.
  plexSyncedAt DateTime?

  /// An import running or finished (Trakt, from its API or an export file),
  /// stored like the backfill's progress so Home can show a card from a row
  /// and a restart mid-way is noticed. `importSummary` is JSON: what was
  /// logged, rated, saved and skipped, for the Trakt sheet to report.
  importSource     String?
  importStage      String?
  importTotal      Int       @default(0)
  importDone       Int       @default(0)
  importStartedAt  DateTime?
  importFinishedAt DateTime?
  importSummary    String?

  /// The two completion bonuses behind the level: how many shows have been
  /// watched to the end of a finished run, and how many franchises are complete.
  /// Both need TMDB to answer, which is far too expensive for a profile render,
  /// so they are cached here and refreshed whenever the achievements page
  /// recomputes the board. Everything else the level is made of — episodes,
  /// films, ratings, badges — is counted live, because it is a plain count.
  levelFinishedShows      Int       @default(0)
  levelFinishedFranchises Int       @default(0)
  levelSyncedAt           DateTime?

  /// The starting line. Everyone begins at level 0, so nothing that arrived with
  /// an imported history counts towards the level — see `achievements/xp.ts`.
  /// Plays carry their own source and need nothing here; badges are marked
  /// `carried` as they unlock; only the two completion bonuses are plain
  /// numbers, so what they stood at when the line was drawn is kept here and
  /// subtracted from the current counts.
  levelBaseShows      Int       @default(0)
  levelBaseFranchises Int       @default(0)
  levelBaselineAt     DateTime?
  /// When this account's stored level state (unlocks, both completion counts
  /// and their starting line) was last brought into line with a full offline
  /// evaluation at server start (`repairLevels`). Null means never under the
  /// current rules: a database from the old app arrives with state that its
  /// arithmetic wrote, and the level would otherwise move on the first Badges
  /// visit. Cleared by a migration whenever the rules change.
  levelRepairedAt     DateTime?

  /// Whether the monthly challenge strip on the dashboard is folded away. On the
  /// account rather than in the browser so the choice follows you between the
  /// phone and the desktop — it is a preference about the app, not about one
  /// device's screen.
  challengesCollapsed Boolean @default(false)

  /// Whether the experience breakdown on the achievements page is folded down to
  /// just the bar. On the account for the same reason as the one above.
  xpPanelCollapsed Boolean @default(false)

  /// What stands behind every page (`lib/background.ts`): "gradient",
  /// "artwork" or "colour". Null is plain, the page colour, which is the
  /// default and what every account had before. The shell paints before any
  /// data, so the choice is mirrored in the `trekker_background` cookie, which
  /// the root layout and the boot script read; this row is what the cookie is
  /// written from, so the choice follows the person to their other devices.
  background    String?
  /// The colour variant's hue in degrees, one of the eight swatches. Kept when
  /// another variant is chosen, so going back to colour finds the last pick.
  backgroundHue Int?

  /// The screensaver: minutes of nothing at all before it starts by itself.
  ///
  /// Zero is the off switch, and deliberately the same field as the delay rather
  /// than a boolean beside it — "start it after ten minutes" and "never start it
  /// on its own" are one answer to one question, and two columns would let them
  /// disagree. It can always still be started by hand from the account menu.
  screensaverIdle   Int     @default(0)
  /// Which shelf the slideshow draws from — see `SCREENSAVER_SOURCES`.
  screensaverSource String  @default("trending")
  /// Where to ask about the weather. The place name is resolved to coordinates
  /// once, when it is chosen, so the screensaver never has to geocode anything
  /// while it is running; the name is kept only to print under the temperature.
  /// All three are null when the weather has been left off, which is the default.
  screensaverPlace  String?
  screensaverLat    Float?
  screensaverLon    Float?

  /// The two pushes that are not the morning one, each a yes or no for the
  /// account rather than the device: a friend request or a recommendation the
  /// moment it arrives, and the month's challenges on the first. Whether a
  /// device takes push at all is its `PushSubscription` row; these only say
  /// which of the extra messages its owner wants. Friends is on because those
  /// pushes were sent before there was a switch; challenges is new and off.
  notifyFriends    Boolean @default(true)
  notifyChallenges Boolean @default(false)
  /// News about what this account follows (T2) in the morning push, off
  /// until asked for; the bell and the News page show it either way. Since
  /// Round 10 it is "Push me the big ones" alone: renewals, cancellations,
  /// endings and dates set or moved for what they watch or saved. A new
  /// trailer or next-episode date is not pushed; the page and the bell show it.
  notifyNews       Boolean @default(false)
  /// Round 10: a followed person's new work (announced or released) in the
  /// same morning push, so never more than once a day. Split from
  /// `notifyNews`, which used to carry it; the migration copied that switch's
  /// value here so nobody's push changed on the day.
  notifyNewsPeople Boolean @default(false)

  /// How the News page reads (Settings › News, Round 10). Which chip it opens
  /// on without one in the address: "for-you", "top", or "last" (the last chip
  /// chosen, which only the browser knows, in localStorage).
  newsOpenOn     String  @default("for-you")
  /// Whether opening a For you story marks it read. Off, only Mark all read
  /// clears the count, for someone who treats the count as a to-read pile.
  newsMarkOnOpen Boolean @default(true)
  /// 7 or 30: how far back the page shows headlines. The instance keeps press
  /// rows 30 days for everyone; the shorter value only hides older ones, and
  /// prunes the rows of this account's own feeds when no other owner wants
  /// them longer.
  newsKeepDays   Int     @default(30)

  /// Every achievement id this account has been measured against, comma
  /// separated. What makes a *newly added* achievement that a years-old imported
  /// history satisfies on sight count as carried in rather than earned — without
  /// it, adding a badge to the catalogue would hand out XP for watching nothing.
  levelKnownKeys String?

  episodes       WatchedEpisode[]
  movies         WatchedMovie[]
  plays          Play[]
  watchlist      WatchlistItem[]
  favourites     Favourite[]
  lists          MediaList[]
  ratings        Rating[]
  episodeRatings EpisodeRating[]
  pushDevices    PushSubscription[]
  droppedShows   DroppedShow[]
  achievements   UnlockedAchievement[]
  challenges     ChallengeRun[]
  readNotices    NotificationRead[]

  /// Bumped whenever every existing session should stop working — a password
  /// change, a reset, or "sign out everywhere". Sessions are stateless JWTs, so
  /// without a number to compare against there is no way to revoke one before
  /// its thirty days are up; the token carries the value it was signed with and
  /// `getCurrentUser` refuses anything that no longer matches.
  tokenVersion Int @default(0)

  /// What the profile and the level read instead of counting the play log on
  /// every render. Written only by `recordPlay` and `removePlay`, inside the
  /// same transaction as the rows they count, and always re-derived with a
  /// COUNT rather than incremented — so a path that forgets to adjust them
  /// cannot exist, and running either function again repairs any drift.
  watchedEpisodeCount Int @default(0)
  watchedMovieCount   Int @default(0)
  playCount           Int @default(0)
  minutesWatched      Int @default(0)

  /// The import backfill: working out where this person is in every show in
  /// their history, which needs TMDB once per show. Progress is stored rather
  /// than held in memory so the dashboard can say "Working out where you are in
  /// 84 shows" from a row, and so a restart mid-way is noticed and resumed.
  /// `backfillFinishedAt` null with history present means it has not run yet.
  backfillTotal      Int       @default(0)
  backfillDone       Int       @default(0)
  backfillStartedAt  DateTime?
  backfillFinishedAt DateTime?

  titleStates TitleState[]

  deletedPlays DeletedPlay[]

  sentRequests     Friendship[] @relation("SentFriendRequests")
  receivedRequests Friendship[] @relation("ReceivedFriendRequests")

  sentRecommendations     Recommendation[] @relation("SentRecommendations")
  receivedRecommendations Recommendation[] @relation("ReceivedRecommendations")

  comments         Comment[]
  commentReactions CommentReaction[]
  feelings         Feeling[]

  /// People this person follows from the actor page; see `FollowedPerson`.
  followedPeople FollowedPerson[]
  newsSources    NewsSource[]
  newsFeeds      UserFeed[]

  /// The instance's admin is the oldest account, and the Plex and Overseerr
  /// connections live on it, so "first by createdAt" is asked often.
  @@index([createdAt])
}

/// "You should watch this."
///
/// The one social action the app had no way to perform: you could see a friend's
/// activity, read their reviews and compare scores with them, but not hand them
/// something. Everything else was inferred from what they happened to do.
///
/// Title and poster are denormalised, like every other list row here, so a
/// recommendation renders without a TMDB call — and still reads correctly years
/// later if the artwork has since changed.
model Recommendation {
  id         String @id @default(cuid())
  fromUserId String
  fromUser   User   @relation("SentRecommendations", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("ReceivedRecommendations", fields: [toUserId], references: [id], onDelete: Cascade)

  /// "movie" | "tv"
  mediaType String
  tmdbId    Int
  title     String
  poster    String?
  /// An optional line from the sender. Short on purpose — this is a nudge.
  note      String?

  createdAt   DateTime  @default(now())
  /// When the recipient last saw it in their notifications.
  seenAt      DateTime?
  /// Set when they clear it, so it stops turning up without being deleted.
  dismissedAt DateTime?

  /// One standing recommendation per person per title: pressing it twice is the
  /// same sentence said twice, not two separate suggestions.
  @@unique([fromUserId, toUserId, mediaType, tmdbId])
  @@index([toUserId, dismissedAt])
}

/// A viewing the user deleted that had come from a source carrying its own id.
///
/// Deleting a play removes the row, and with it the `sourceRef` that was the
/// only evidence the sync had already seen that Plex history entry — so the next
/// sync imported it again, ten minutes later, forever. This is the gravestone:
/// `recordPlay` consults it before creating anything sourced, so "I did not
/// watch that" survives a re-sync.
///
/// Deliberately permanent. Watching the thing again on Plex writes a *new*
/// history entry with a new `viewedAt`, hence a new ref, which is not buried
/// here — so a real rewatch still lands.
model DeletedPlay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "plex" | "trakt" — matches `Play.source`.
  source    String
  sourceRef String
  deletedAt DateTime @default(now())

  @@unique([userId, source, sourceRef])
}

/// One row per pair, owned by whoever asked first. A pair is friends only once
/// the addressee has accepted; until then the row is the outstanding request.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  /// "pending" | "accepted"
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// One row per episode a user has watched.
///
/// This and `WatchedMovie` are a uniqueness index over `Play` rather than a
/// second record of what happened: they answer "have I seen this", while the
/// play log answers "how often, and when". Only `src/lib/plays.ts` writes them.
model WatchedEpisode {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId        Int
  showName      String
  showPoster    String?
  seasonNumber  Int
  episodeNumber Int
  episodeName   String
  runtime       Int       @default(42)
  /// The *first* time it was watched — the oldest play. Rewatches move
  /// `lastWatchedAt` instead, so "when did I discover this" survives them.
  watchedAt     DateTime  @default(now())
  lastWatchedAt DateTime?
  /// How many plays there are. Denormalised so the title page does not need a
  /// GROUP BY, and a free drift check against COUNT(*) on the log.
  plays         Int       @default(1)

  @@unique([userId, showId, seasonNumber, episodeNumber])
  @@index([userId, watchedAt])
}

model WatchedMovie {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId       Int
  title         String
  poster        String?
  runtime       Int       @default(0)
  /// TMDB audience score (0-100) captured when it was logged.
  score         Int?
  /// The first time it was watched. See `WatchedEpisode.watchedAt`.
  watchedAt     DateTime  @default(now())
  lastWatchedAt DateTime?
  plays         Int       @default(1)

  @@unique([userId, movieId])
  @@index([userId, watchedAt])
}

/// One viewing. Append-only: the log of what was actually watched and when,
/// which is what makes rewatches countable.
///
/// Everything that asks "how much have I watched" reads this; everything that
/// asks "have I seen it" reads `WatchedMovie` / `WatchedEpisode`. Writes go
/// through `recordPlay` in `src/lib/plays.ts` and nowhere else — that is what
/// keeps the two in step.
model Play {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "movie" | "tv"
  mediaType     String
  /// The film's id, or the *show's* id for an episode.
  tmdbId        Int
  /// Film title, or show name. Denormalised so the log describes itself.
  title         String
  poster        String?
  seasonNumber  Int?
  episodeNumber Int?
  episodeName   String?
  runtime       Int      @default(0)
  watchedAt     DateTime @default(now())
  /// "manual" | "plex" | "trakt" | "backfill"
  source        String   @default("manual")
  /// Stable id from whichever source reported it, where one exists. Plex play
  /// history gives `${ratingKey}:${viewedAt}`; a manual tick has nothing, hence
  /// null. SQLite treats nulls as distinct in a unique index, so the manual and
  /// backfilled rows never collide with each other — only the sourced ones do,
  /// which is exactly the deduplication wanted.
  sourceRef     String?

  @@unique([userId, source, sourceRef])
  @@index([userId, watchedAt])
  @@index([userId, mediaType, tmdbId, watchedAt])
}

/// A notification the user has dismissed.
///
/// Notifications themselves are *derived* rather than stored — an outstanding
/// friend request is a pending `Friendship`, a new badge is an
/// `UnlockedAchievement` — so the list can never disagree with reality: accept a
/// request and its notification stops existing, with nothing to keep in step.
/// The one thing that cannot be derived is whether it has been seen, which is
/// all this table holds.
model NotificationRead {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `friend:<friendshipId>` or `badge:<achievementId>`.
  key       String
  readAt    DateTime @default(now())
  /// Cleared away rather than merely seen. A read notification stays on the
  /// list, greyed — a friend request you have read is still one you have not
  /// answered — so "clear" is the separate, deliberate act of getting rid of it.
  dismissed Boolean  @default(false)

  @@unique([userId, key])
  @@index([userId])
  /// This table only ever grows, so the daily job keeps the newest 200 rows
  /// per user (`capNotificationReads`), and this is the order it keeps them in.
  @@index([userId, readAt])
}

/// Something still meant to be watched.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType String // "movie" | "tv"
  tmdbId    Int
  title     String
  poster    String?
  score     Int?
  addedAt   DateTime @default(now())

  /// Filled in by the daily job, 24 rows a pass, so the watchlist can be sorted
  /// by length and by what is streaming now. Both go stale, hence the stamp:
  /// a row is looked at again a week after its last lookup, whether or not
  /// that lookup found a length. A show's length here is one episode's.
  runtime      Int?
  /// Comma-separated streaming provider names for the owner's region, or ""
  /// when nothing streams it. Null means "not looked up yet".
  streaming    String?
  /// The same offers as TMDB provider ids. Names are what gets shown; ids are
  /// what gets compared, because TMDB lists one service under several of them
  /// and which one a title comes back under varies — see `KNOWN_PROVIDERS`.
  streamingIds String?
  enrichedAt   DateTime?

  /// When a watchlisted film arrives, for the calendar and Landing soon: the
  /// cinema release and the streaming (digital) release in the owner's region,
  /// as YYYY-MM-DD text like every other air date here. Films only. Written by
  /// the daily job from the cached TMDB answers, so the calendar never asks TMDB
  /// on a render. Null means unknown, not "never".
  releaseDate      String?
  streamingDate    String?
  /// When the two above were last worked out. A film already out both ways is
  /// settled and looked at monthly rather than daily.
  releaseCheckedAt DateTime?

  @@unique([userId, mediaType, tmdbId])
}

/// Something loved, as opposed to something queued.
///
/// Deliberately not a `MediaList`: the heart on a title page is one press with
/// no list to choose, every user has exactly one of these, and it must never be
/// renamed or deleted. A row of its own keeps that guarantee in the schema
/// rather than in the code that reads it.
model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType String // "movie" | "tv"
  tmdbId    Int
  title     String
  poster    String?
  score     Int?
  addedAt   DateTime @default(now())

  @@unique([userId, mediaType, tmdbId])
  @@index([userId, addedAt])
}

/// A list the user made: either one they fill by hand, or a standing question.
///
/// The watchlist and the favourites are *not* rows here — they are fixed parts
/// of the app with their own tables, their own meaning and their own consumers
/// (Plex sync reads the watchlist; the calendar and the quiz do too). This table
/// is only for the lists a user invents, which is what makes deleting one safe.
model MediaList {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  /// "manual" — the user adds titles by hand.
  /// "smart"  — the titles are whatever `filters` currently answers.
  kind    String  @default("manual")
  /// The smart list's question, as JSON matching `SmartFilters` in
  /// `src/lib/smart-filters.ts`. Null on a manual list. Stored as text because
  /// nothing ever queries *into* it: it is read whole, parsed, and re-run.
  filters String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// When a smart list's answers were last rebuilt from TMDB. Null means never,
  /// which is also what a freshly edited list is set back to.
  refreshedAt DateTime?

  /// Ask Overseerr for what turns up on this list, without being told to.
  ///
  /// Off by default and deliberately opt-in per list: a standing question that
  /// files requests on its own is the one feature here that spends somebody
  /// else's disk, and "top rated films of all time" would ask for four hundred
  /// of them. In the rebuild only what is new to the list at a daily rebuild
  /// is asked for, by Request all's rule (unseen, not on Plex, not on a service
  /// the owner pays for), twenty a day at most, and each one is recorded in
  /// `MediaListRequest` so it is never asked for twice.
  autoRequest         Boolean   @default(false)
  /// The current app's: "missing" skips anything already streaming on a
  /// service the user pays for, "all" asks for everything. The rebuild always
  /// skips, as Request all does, and does not read this.
  autoRequestScope    String    @default("missing")
  /// The current app's per-run limit. The rebuild's is a fixed twenty a day
  /// (`AUTO_REQUEST_DAILY_CAP`) and does not read this.
  autoRequestCap      Int       @default(5)
  /// When a run last filed anything, for the panel to report.
  autoRequestedAt     DateTime?
  /// What that run filed: how many, and the first few titles, comma separated.
  /// Denormalised like every list row, so the bell can say what happened
  /// without asking Overseerr anything.
  autoRequestedCount  Int       @default(0)
  autoRequestedTitles String?

  items    MediaListItem[]
  requests MediaListRequest[]

  @@index([userId, createdAt])
}

/// A title a smart list asked Overseerr for on its own. The record that stops
/// a title being requested twice however often it leaves the list and comes
/// back, and what the twenty-a-day cap counts. Goes with its list.
model MediaListRequest {
  listId      String
  list        MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaType   String // "movie" | "tv"
  tmdbId      Int
  requestedAt DateTime  @default(now())

  @@id([listId, mediaType, tmdbId])
  @@index([listId, requestedAt])
}

/// One title on a list.
///
/// For a manual list this is the record — the only place that membership
/// exists. For a smart list it is a cache of the last answer, thrown away and
/// rewritten on every refresh, so that opening the list is a database read
/// rather than a fan of TMDB requests.
model MediaListItem {
  id        String    @id @default(cuid())
  listId    String
  list      MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaType String // "movie" | "tv"
  tmdbId    Int
  title     String
  poster    String?
  score     Int?
  /// Release year as TMDB gives it, for the card caption. Text, because it is
  /// only ever printed and TMDB leaves it blank on unannounced titles.
  year      String?
  /// Minutes to watch the whole thing: a film's length, or a show's episode
  /// length times its episodes. What the list page's hours and its "Shortest"
  /// order read. Written when a title is added by hand, from the details the
  /// add has already read, and on a smart list by the daily job, carried over
  /// between rebuilds and topped up through the cached details. Null is "not
  /// known yet", which sorts last and adds nothing to the hours.
  runtime   Int?
  /// Where it sits in the list: insertion order by hand, TMDB's own ranking on
  /// a smart list. Sorting on this is what keeps "best rated first" meaningful
  /// after the rows have been shuffled through the database.
  position  Int       @default(0)
  addedAt   DateTime  @default(now())

  @@unique([listId, mediaType, tmdbId])
  @@index([listId, position])
}

/// A popcorn rating on a single episode, on the same five buckets as `Rating`.
///
/// It began as a thumbs up or down, and `liked` is kept so nothing that was
/// said is thrown away. The migration mapped up to "full" (4) and down to
/// "empty" (2): neither extreme, because a thumb never said golden or spilled.
/// `score` is what the app reads and writes now; `liked` is left in step with
/// it (true from 4 up) only so the previous app can still share the database.
model EpisodeRating {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId        Int
  seasonNumber  Int
  episodeNumber Int
  liked         Boolean
  /// 1 spilled, 2 empty, 3 half full, 4 full, 5 golden.
  score         Int?
  updatedAt     DateTime @updatedAt

  @@unique([userId, showId, seasonNumber, episodeNumber])
  @@index([userId, showId])
}

/// A show the user has given up on. The watched episodes stay — this only says
/// "stop asking me about it", so it drops out of Up next and the calendar.
model DroppedShow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId    Int
  showName  String
  createdAt DateTime @default(now())

  @@unique([userId, showId])
  @@index([userId])
}

/// One row per browser that has agreed to receive notifications. The keys are
/// the browser's own, and are useless to anyone but its push service.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Free text from the browser, so a user can tell their devices apart.
  label     String?
  createdAt DateTime @default(now())
  /// Last date (YYYY-MM-DD) this device was told about, so a reminder is not
  /// repeated if the job runs more than once a day.
  lastSent  String?

  @@index([userId])
}

/// An achievement a user has earned. Progress itself is always recomputed from
/// the watch history — only the moment of earning is worth keeping, because it
/// is the one thing that cannot be derived again later.
///
/// `key` is an id from the catalogue in `src/lib/achievements/catalogue.ts`.
/// Rows for keys that no longer exist are ignored rather than deleted, so a
/// renamed achievement does not throw away someone's history.
model UnlockedAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())
  /// True when this badge came with an imported history rather than being earned
  /// here: either the history alone meets it (the imported plays and those from
  /// before the account's starting line, however long after the line its title
  /// facts arrive), or it was added to the catalogue later and a years-old
  /// history met it on sight. The badge is kept and shown either way — it is a true statement
  /// about what someone has watched — but it pays no XP towards the Trekker
  /// level. It still counts towards the lifetime figure.
  carried    Boolean  @default(false)

  @@unique([userId, key])
  @@index([userId])
  /// "Recently earned", newest first, without sorting every badge ever won.
  @@index([userId, unlockedAt])
}

/// A monthly challenge someone finished. One row per challenge per month, so a
/// challenge that comes round again next year is a fresh thing to win.
///
/// Like `UnlockedAchievement`, only the moment is stored — the progress behind
/// it is recomputed from that month's plays every time it is shown. The XP is
/// written down because the reward is fixed when it is won: retuning a
/// challenge later should not quietly restate what someone already earned.
model ChallengeRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Challenge id from `src/lib/challenges/catalogue.ts`.
  key         String
  /// The month it belongs to, as "YYYY-MM".
  period      String
  xp          Int
  completedAt DateTime @default(now())

  @@unique([userId, key, period])
  @@index([userId, period])
}

/// Facts about a title that TMDB knows and we do not store on the watched rows:
/// genres, language, release date, franchise. Shared by every user rather than
/// copied per row, and refreshed only when it ages out — the achievements page
/// asks about hundreds of titles at once and none of this moves.
model TitleMeta {
  id               String   @id @default(cuid())
  mediaType        String // "movie" | "tv"
  tmdbId           Int
  title            String
  /// Genre names, comma separated. Names rather than ids because TMDB numbers
  /// film and television genres differently for the same idea.
  genres           String
  /// ISO 639-1, e.g. "en", "ko".
  originalLanguage String?
  /// YYYY-MM-DD: a film's release, a show's first air date.
  releaseDate      String?
  runtime          Int?
  /// TMDB collection ("belongs to" franchise), films only.
  collectionId     Int?
  collectionName   String?
  fetchedAt        DateTime @default(now())

  @@unique([mediaType, tmdbId])
}

/// A popcorn rating on a whole title: one of five buckets, stored 1 to 5 —
/// spilled, empty, half full, full, golden. Shown as one bucket and its name.
///
/// Scores used to be percentages. The migration to buckets is lossy by design
/// (`ceil(percent / 20)`: 1-20 spilled, 21-40 empty, 41-60 half full, 61-80
/// full, 81-100 golden, the same as halving a score out of ten and rounding
/// up), so the percentage is kept in `legacyScore` in case the mapping ever
/// needs revisiting. Nothing reads it; nothing new writes it.
model Rating {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType   String
  tmdbId      Int
  title       String
  poster      String?
  score       Int // 1-5 popcorn
  legacyScore Int?
  review      String?
  updatedAt   DateTime @updatedAt

  @@unique([userId, mediaType, tmdbId])
}

/// A comment on a title, readable by everyone signed in to this instance.
///
/// The first thing here that is not friends-only, and deliberately so. A review
/// is a paragraph about your own score and stays between friends — see
/// `lib/reviews.ts`; this is a conversation, and a conversation nobody outside
/// your friends can join is a diary with extra steps. Watch history and profiles
/// are unaffected and still private.
///
/// One level of replies: `parentId` is null for a comment and set for a reply,
/// and a reply cannot itself be replied to. That is enforced in `postComment`
/// rather than by the schema, since SQL cannot express "parent must be a root"
/// — the check is a read of the parent's own `parentId`.
model Comment {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType        String
  tmdbId           Int
  body             String
  parentId         String?
  /// Cascading is what makes deleting a comment take its replies with it.
  parent           Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]         @relation("Replies")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  commentReactions CommentReaction[]

  /// The read the title page makes: everything said about one title, in order.
  @@index([mediaType, tmdbId, createdAt])
  @@index([parentId])
  @@index([userId])
}

/// One emoji from a fixed set, per person per comment.
///
/// The unique key is what makes the same emoji twice a toggle rather than two
/// reactions, while leaving somebody free to add several different ones.
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

/// How a title made somebody feel, from the fixed set in `lib/feelings.ts`.
///
/// A score says how good it was and a review says why; neither answers "what was
/// it like to watch". One per person per title, and picking the one you already
/// have clears it — the same shape as an episode thumb, for the same reason:
/// there is no third state to explain and no separate control to find.
///
/// Public, like comments and unlike everything older than them.
model Feeling {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType     String
  /// The film's id, or the *show's* id for an episode.
  tmdbId        Int
  /// Which episode it is about. Zero for a film, and for the show-level rows
  /// left behind by the version of this that asked on the show's own page.
  ///
  /// Zero rather than null, deliberately, and for the reason `WatchedEpisode`
  /// does the same: SQLite treats NULLs in a unique index as distinct, so a
  /// nullable column here would let one person hold any number of feelings
  /// about the same film. Zero is a value, and the index means what it says.
  seasonNumber  Int      @default(0)
  episodeNumber Int      @default(0)
  feeling       String
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaType, tmdbId, seasonNumber, episodeNumber])
  /// The tally a film's page and an episode's page each draw.
  @@index([mediaType, tmdbId, seasonNumber, episodeNumber])
}

/// Where one person is in one show, stored so that no page has to work it out.
///
/// The previous app computed this on every dashboard, calendar and discover
/// render by asking TMDB about every show in the history, which is what made it
/// slow. Here it is a row, written from two sides and read by everything:
///
/// - the **watched half** (`watchedCount`, `lastWatchedAt`, and the next
///   episode, since what comes next depends on what has been seen) by
///   `recordPlay` and `removePlay`, synchronously, from rows alone;
/// - the **aired half** (`airedCount`, `totalCount`, `status`, `lastAirDate`,
///   and the next episode again) by the refresh job, from `ShowEpisode`, which
///   it fills from the TMDB cache.
///
/// Both halves go through `recomputeTitleState`, so they cannot disagree about
/// what "next" means. Name and artwork are denormalised like every list row, so
/// Up next renders without a TMDB call.
model TitleState {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId Int

  showName   String
  showPoster String?
  backdrop   String?

  /// "returning" | "ended" | "cancelled" | "upcoming". Only returning shows are
  /// re-fetched every six hours; the rest are settled and wait for the daily pass.
  status       String  @default("returning")
  /// Episodes in numbered seasons that have aired, as of the last computation.
  airedCount   Int     @default(0)
  /// Distinct episodes of numbered seasons this person has seen. Specials are
  /// left out of both counts, so progress reads the way the show is numbered.
  watchedCount Int     @default(0)
  /// Every announced episode in numbered seasons, aired or not.
  totalCount   Int     @default(0)
  /// YYYY-MM-DD, plain text like TMDB gives it: turning an air date into a
  /// timestamp is how an episode lands on the wrong day west of UTC.
  lastAirDate  String?
  /// The show's first air date. The calendar marks a series premiere from the
  /// episode list when season one is listed; this covers the announced show
  /// whose episodes TMDB has not published yet. Aired half, like the above.
  premiereDate String?

  /// The first episode, in order, that this person has not seen. When its air
  /// date is today or earlier it is Up next; when it is later, the show is
  /// caught up and the episode is "landing soon". Null when there is nothing
  /// left, or when the episode list has not been fetched yet.
  nextSeason  Int?
  nextEpisode Int?
  nextTitle   String?
  nextAirDate String?
  nextRuntime Int?
  nextStill   String?

  /// The latest viewing of any episode, for ordering Up next by what is warm.
  lastWatchedAt DateTime?
  /// Up next holds still while someone works through it on Home. Ordered by
  /// `lastWatchedAt` alone, ticking a show in Also waiting makes it the warmest
  /// and it jumps to the card; so a tick from Home freezes the row's warmth as
  /// it stood before that day's first Home tick, and the row orders by this
  /// instead for the rest of the day. A viewing from anywhere else (a title
  /// page, Plex) clears it: that is new information, and reordering for it is
  /// right. Tomorrow the day's ticks count like any other.
  heldAt        DateTime?
  /// The day, YYYY-MM-DD in server time, that `heldAt` applies to. On any other
  /// day it is ignored, so nothing has to clear it at midnight.
  heldOn        String?
  /// When the aired half was last computed. Null means never: the show has not
  /// been through the refresh job, so the next episode is not known yet.
  airedAt       DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([userId, showId])
  /// Up next and Also waiting: this person's shows, warmest first.
  @@index([userId, lastWatchedAt])
  /// Landing soon and the calendar: this person's next episodes by date.
  @@index([userId, nextAirDate])
  /// The refresh job: every user following a show it has just re-fetched.
  @@index([showId])
  @@index([status])
}

/// Every episode of every show somebody here follows, shared by all users.
///
/// Filled by the refresh job from the cached season lists. This is what lets
/// "what is next" and "what airs this week" be a query instead of a walk through
/// TMDB JSON: the next episode is the first row here with no `WatchedEpisode`
/// beside it, and a week of the calendar is a date range over `airDate`.
model ShowEpisode {
  showId        Int
  seasonNumber  Int
  episodeNumber Int
  name          String
  /// YYYY-MM-DD, or null while TMDB has not dated it.
  airDate       String?
  runtime       Int?
  still         String?
  /// TMDB's "standard" | "premiere" | "finale" | "mid_season", where it says.
  episodeType   String?
  fetchedAt     DateTime @default(now())

  @@id([showId, seasonNumber, episodeNumber])
  @@index([airDate])
}

/// The TMDB cache, on the data volume.
///
/// The previous app cached TMDB in `.next/cache`, which is thrown away with the
/// container on every update, so the first visit after one fetched the whole
/// library again. A table survives that, and a lifetime per endpoint (details a
/// week, seasons a day, trending an hour) means rarely-changing answers are not
/// refetched hourly. `key` is the path plus its sorted query parameters.
model TmdbCache {
  key       String   @id
  /// The response exactly as TMDB sent it, as JSON text.
  body      String
  fetchedAt DateTime @default(now())
  /// Past this the entry is refetched on read. It is kept until then and
  /// served stale if TMDB cannot be reached, because an old answer beats none.
  expiresAt DateTime

  @@index([expiresAt])
}

/// Where a title can be watched: on the household's Plex, requested or
/// available through Overseerr, and on which streaming services per region.
///
/// Refreshed by the daily job for everything on a watchlist, a favourite or a
/// list, and never on a render. This is what the Plex chip, the Overseerr mark
/// on posters and the availability panel read.
model Availability {
  /// "movie" | "tv"
  mediaType       String
  tmdbId          Int
  onPlex          Boolean   @default(false)
  plexRatingKey   String?
  /// "none" | "requested" | "available"
  overseerrStatus String    @default("none")
  /// JSON: `{ "GB": { "link": "...", "stream": [{ "id": 8, "name": "Netflix" }], ... } }`
  /// for the regions somebody on this instance uses. Null means never looked up.
  providers       String?
  checkedAt       DateTime?

  /// Written by the Overseerr webhook and by a request filed here, so the bell
  /// can say "now on Plex" from rows: when Overseerr said the title arrived,
  /// who asked for it (a Trekker account, when the requester could be matched),
  /// and the title and poster denormalised, since the requester may have no
  /// other row that names it.
  availableAt   DateTime?
  requestedById String?
  title         String?
  poster        String?

  @@id([mediaType, tmdbId])
  @@index([checkedAt])
  @@index([availableAt])
}

/// People from TMDB, cached for the actor page and cast rails.
///
/// `knownForBackdrop` is the artwork of the title they are best known for, so
/// the actor page has a hero without a second lookup.
model Person {
  tmdbId            Int      @id
  name              String
  profilePath       String?
  /// "movie" | "tv", with the id below.
  knownForMediaType String?
  knownForTitleId   Int?
  knownForBackdrop  String?
  bio               String?
  fetchedAt         DateTime @default(now())

  /// Following a person: what their credits were at the daily job's last look,
  /// so the next look can tell what is new. JSON, `{ "movie-603": "1999-03-31",
  /// "tv-1399": "" }`, every part and direction by key with its date (empty
  /// when TMDB has none yet), because "released" is a dated part that was
  /// undated or in the future last time. Null until someone follows them: the
  /// first look only draws the line, so following someone never floods the
  /// news with a career's worth of old work.
  credits          String?
  /// When `credits` was taken. The job reads the person through the cache,
  /// which keeps them a week, so a day between looks is plenty.
  creditsCheckedAt DateTime?
}

/// A person someone follows: an actor or director whose new work they want to
/// hear about. The daily job checks each followed person once however many
/// people follow them, and writes what is new to `PersonNews`; the
/// notification that tells the follower arrives with step 7.
model FollowedPerson {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TMDB's person id. Not a relation to `Person`: that row is a cache, and
  /// can be rebuilt or pruned without anyone losing who they follow.
  personId   Int
  followedAt DateTime @default(now())

  @@id([userId, personId])
  /// The daily job: everyone followed by anyone.
  @@index([personId])
}

/// News about what someone follows (T2), found by the refresh job at the
/// moment it writes a newer answer over an older one, so it is a comparison
/// at the point of write rather than a second pass. Four subjects:
///
/// - "person": a followed person's part announced (in their credits for the
///   first time, not out yet) or released (dated today or earlier where it was
///   undated or in the future at the last look). The daily look; the first
///   look, at the follow, seeds what is upcoming or just out (Round 9).
/// - "tv": a show someone watches or has saved is renewed, cancelled or ends
///   (its status), gets a next-episode date or the date moves, has a new
///   season announced (the season count rises), or a new trailer. The
///   six-hourly returning pass.
/// - "movie": a saved film's release date is set or moves, or it gets a
///   trailer. The six-hourly pass, for saved films not long out.
/// - "press" (Round 9): a headline from an entertainment site's RSS or Atom
///   feed, read by the daily pass (`lib/press.ts`), for everyone: the News
///   page's Popular tab, never the bell, Home or a count. Only the headline,
///   its link, the source's name, when it was published and the feed's
///   picture are kept, never the article. Kept thirty days.
///
/// Shared by everyone the subject concerns and stored once; who sees what is
/// worked out on reading (`lib/news.ts`): a person's news from
/// `FollowedPerson.followedAt`, a title's for anyone with it in progress or
/// saved. Read state is the bell's `NotificationRead`, keyed `news:<id>`,
/// so the bell, the News page, Home's rail and the sidebar's count agree.
/// Replaces `PersonNews`, whose rows were carried over with their ids, so
/// their read marks still hold. Title, poster and words denormalised, like
/// every row a list renders.
model NewsItem {
  id        String   @id @default(cuid())
  /// "person" | "tv" | "movie" | "press"
  subject   String
  /// The subject's TMDB id: the person's, or the title's own. 0 for press.
  subjectId Int
  /// person: "announced" | "released"; tv: "renewed" | "cancelled" | "ended" |
  /// "next-date" | "date-moved" | "new-season" | "trailer"; movie:
  /// "release-date" | "trailer"; press: "press".
  kind      String
  /// The title the news links to: a person's credit, or the title itself; for
  /// press, the title the headline names, when the cache knows one (null
  /// otherwise, as are `tmdbId` and `title`).
  /// "movie" | "tv"
  mediaType String?
  tmdbId    Int?
  title     String?
  /// The title's poster, or a person's headshot for theirs: a TMDB path.
  image     String?
  /// "Silo renewed for season 4", "New from Kyle Chandler"; a press row's
  /// headline as its feed gave it, tags stripped and entities decoded.
  headline  String
  /// "Season 4 announced", "Lanterns announced". Empty for press.
  detail    String
  /// When the job noticed, not the date in the news: the news is that it
  /// changed. A press row's is when its feed says it was published.
  at        DateTime @default(now())
  /// What the change was, so each is news once however many passes see it and
  /// a status flapping back and forth is not news twice:
  /// "tv:95396:status:ended", "movie:693134:release:2026-12-18",
  /// "person:3497:tv-2:announced", "press:<link>".
  key       String   @unique
  /// Press only: the site's name ("Variety"), the article's address (an
  /// absolute http(s) URL, unique: an article is one row whichever feed
  /// carried it), and the feed's picture for it (an absolute https URL). When
  /// the feed has none, the pass reads the article's head once for its
  /// `og:image` (Round 10 review); "" means it looked and found none, so the
  /// row is not asked again, and null that it has not looked yet.
  source    String?
  link      String?  @unique
  imageUrl  String?
  /// Round 10, press only. What the headline is about, from a keyword rule
  /// on the headline at record time (`classifyHeadline` in `lib/press.ts`):
  /// "renewed" | "cancelled" | "trailer" | "casting" | "box-office" |
  /// "reviews" | "dated" | "moved", so the News page's chips are a column, not
  /// a pass over every headline per render. "" is classified and about none
  /// of those; null is a row from before Round 10 not yet looked at, which the
  /// next feed pass classifies once.
  tag       String?
  /// Round 10, press only: the feed's own summary line for the item, as plain
  /// text, its first two sentences and at most 220 characters, which is what
  /// a feed publishes it for. Never the article's body: the page shows the
  /// headline, this line, the source and the link out, and nothing more.
  summary   String?
  /// Round 10, press only: the feed the row came from, so a person's sources
  /// (`NewsSource`) and their own feeds (`UserFeed`) filter by a column
  /// rather than a join through the source's name. An article two feeds carry
  /// is still one row, under the feed that brought it first.
  feedUrl   String?

  @@index([subject, subjectId, at])
  @@index([at])
  @@index([feedUrl])
}

/// Round 10: one person's choice about one of the instance's feeds
/// (`feedList()`). A feed with no row is on, so a new feed in `NEWS_FEEDS`
/// reaches everyone and only a switch turned off needs storing. Keyed by the
/// feed's address; Settings shows one switch per source name, which writes a
/// row for each address under that name (Variety has two feeds).
model NewsSource {
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedUrl String
  enabled Boolean

  @@id([userId, feedUrl])
}

/// Round 10: an RSS or Atom feed someone added for themselves. Read by the
/// same passes as the instance's feeds (on opening News, and daily), gated
/// and fail-soft with them, 40 kept per feed; its rows are `NewsItem` press
/// rows with this `url` as their `feedUrl`, shown to the people who added
/// it and nobody else. Ten per person. Removing one deletes its rows unless
/// someone else still has the same address.
model UserFeed {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url     String
  /// The feed's own title when it was added, or its host.
  name    String
  enabled Boolean  @default(true)
  addedAt DateTime @default(now())

  @@unique([userId, url])
  @@index([url])
}
