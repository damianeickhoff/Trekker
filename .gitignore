# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which exists to be shared. It carries the only
# instructions for generating AUTH_SECRET, and the server now refuses to start
# without a real one — so an unshipped example is a deployment that cannot boot
# and cannot find out why.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local db
*.db
*.db-journal
.env

# per-worker test databases, rebuilt from the migrations on every run
tests/.tmp/


